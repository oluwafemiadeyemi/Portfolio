# ── Large data files ──────────────────────────────────────────────────────────
**/data/raw/
**/data/raw/**
*.csv
*.json
*.json.gz
# Allow package/config JSON files in portfolio website and other non-data paths
!portfolio-website/package.json
!portfolio-website/tsconfig.json
!portfolio-website/vercel.json
!portfolio-website/package-lock.json
*.parquet
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# ── Images / video assets (large binaries) ────────────────────────────────────
**/Images/
**/Video/
**/videos/
**/assets/*.mp4
**/assets/*.avi
**/assets/*.mov
**/Dataset/
**/datasets/

# ── Keep model metadata but not weights ───────────────────────────────────────
!**/data/models/metrics.json
!**/data/models/eval_metrics.json
!**/data/models/*_meta.json
!**/data/models/feature_cols.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.venv/
venv/
env/
*.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── YOLO training runs ────────────────────────────────────────────────────────
**/runs/
**/weights/
**/data/models/retail_ops/
**/data/models/ppe_safety/

# ── Secrets ───────────────────────────────────────────────────────────────────
kaggle.json
*.kaggle
secrets/
credentials/

# ── Large dataset archives ────────────────────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.7z
*.gz

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Keep docs/screenshots PNGs and recordings MP4 ────────────────────────────
!**/docs/
!**/docs/screenshots/
!**/docs/screenshots/*.png
!**/docs/recordings/
!**/docs/recordings/*.mp4
!**/docs/recordings/*.webm
!**/docs/reports/
!**/docs/reports/*.md

# ── Keep metrics and model info JSON ─────────────────────────────────────────
!**/models/metrics.json
!**/models/model_info.json
!**/models/osha_rules.json

# ── Monitor / temp scripts ────────────────────────────────────────────────────
launch_remaining.sh
monitor.log
install_all_packages.bat
MASTER_TRANSFORMATION_PLAN.md
test_imports.py
capture_dashboards.py

# ── Portfolio Dashboard temp ──────────────────────────────────────────────────
Portfolio\ Dashboard/utils/__pycache__/
Portfolio\ Dashboard/views/__pycache__/

